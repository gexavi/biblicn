# Copiez ce fichier en .env (à côté de docker-compose.yml) et adaptez les valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore).

# Identifiant/mot de passe de connexion à l'application (obligatoires, aucune
# valeur par défaut : l'application refuse de démarrer sans eux).
AUTH_USERNAME=admin
AUTH_PASSWORD=changez-moi

# Durée de validité d'une session avant reconnexion nécessaire (en jours).
# Défaut : 30
SESSION_DURATION_DAYS=30

# Largeur maximale (en pixels) des couvertures mises en cache localement.
# Défaut : 500
COVER_MAX_WIDTH=500

# Qualité de compression JPEG des couvertures (1-100).
# Défaut : 82
COVER_JPEG_QUALITY=82

# Fréquence de la sauvegarde automatique de la base et des couvertures (en jours).
# Défaut : 15
BACKUP_INTERVAL_DAYS=15

# Nombre de sauvegardes automatiques conservées avant suppression des plus anciennes.
# Défaut : 6 (~3 mois d'historique au rythme par défaut de 15 jours)
BACKUP_KEEP=6
